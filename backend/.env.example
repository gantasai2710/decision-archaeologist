MEMORY_MODE=hindsight

# Hindsight Cloud
HINDSIGHT_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=your-hindsight-cloud-api-key-here
HINDSIGHT_BANK_ID=decision-arch

# Frontend origin(s) allowed by CORS, comma-separated (Vite dev server)
CORS_ORIGINS=http://localhost:5173

# Optional tuning (defaults shown). Lower budgets cost less.
# HINDSIGHT_RECALL_BUDGET=mid        # low | mid | high
# HINDSIGHT_REFLECT_BUDGET=low       # low | mid | high
# HINDSIGHT_TIMEOUT_SECONDS=90
# HINDSIGHT_AUTO_CREATE_BANK=false   # leave false on Cloud; your bank already exists
# LOG_LEVEL=INFO
